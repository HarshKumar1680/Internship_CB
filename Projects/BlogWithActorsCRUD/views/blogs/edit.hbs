 <h1>Edit Blog</h1>

<form action="/blogs/{{blog._id}}/update" method="POST" class="blog-form">
  <div class="form-group">
    <label for="title">Title:</label>
    <input name="title" id="title" value="{{blog.title}}" required>
  </div>

  <div class="form-group">
    <label for="actor">Actor:</label>
    <input name="actor" id="actor" value="{{blog.actor}}" required>
  </div>

  <div class="form-group">
    <label for="description">Description:</label>
    <textarea name="description" id="description" rows="4" cols="50" required>{{blog.description}}</textarea>
  </div>

  <button type="submit">Update Blog</button>
</form>

