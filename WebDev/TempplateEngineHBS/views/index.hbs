<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
 
    <title>Document</title>
</head>
<body>
    <h1>My task list</h1>
    <form action="/addtask" method="POST">
    <input type="text" name="task">
    <button type="submit"> Add task</button>
    </form>

    <ul>
        {{#each tasklist as |t|}}
            <li>{{t}}</li>
        {{/each}}
    </ul>
</body>
</html>